{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/enrichmeai/penstock/main/schema/fact.schema.json",
  "title": "Fact",
  "description": "One durable belief with provenance, scope, status and confidence; superseded, never edited into a different claim (facts/<id>.yaml). Necessary, not sufficient: cross-file rules (id = filename, provenance, supersede pairs, one active fact per subject, credential grep) live in scripts/check-cards.sh.",
  "type": "object",
  "required": [
    "id",
    "format",
    "visibility",
    "statement",
    "kind",
    "subject",
    "scope",
    "status",
    "confidence",
    "provenance",
    "first_seen",
    "last_confirmed"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "integer",
      "const": 1,
      "description": "Major version of the memory format (docs/memory-format.md). A reader accepts a card whose major it knows."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shareable",
        "public"
      ],
      "description": "Who may see this card: the owner only; people or agents the owner grants; anyone."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "statement": {
      "type": "string",
      "pattern": "\\S"
    },
    "kind": {
      "type": "string",
      "enum": [
        "account",
        "identifier",
        "location-of-secret",
        "convention",
        "decision",
        "principle"
      ]
    },
    "subject": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "pattern": "^(estate|project:[a-z0-9-]+|repo:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "asserted",
        "inferred",
        "superseded"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "episode": {
            "type": "string"
          },
          "learned": {
            "type": "string"
          }
        }
      }
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_confirmed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
